# API
SCHOLARFLOW_APP_NAME=ScholarFlow API
SCHOLARFLOW_LOG_LEVEL=info
SCHOLARFLOW_CORS_ORIGINS=http://localhost:4200

# Data stores (local Docker defaults)
SCHOLARFLOW_DATABASE_URL=postgresql://scholarflow:scholarflow@localhost:5432/scholarflow
SCHOLARFLOW_VECTOR_STORE_URL=http://localhost:6333

# Retrieval
SCHOLARFLOW_COLLECTION_PREFIX=scholarflow
SCHOLARFLOW_EMBEDDING_MODEL=local-hash-v1
SCHOLARFLOW_EMBEDDING_DIMENSIONS=384

# Inference (phase 4+)
# SCHOLARFLOW_INFERENCE_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=

# Postgres (docker-compose)
POSTGRES_USER=scholarflow
POSTGRES_PASSWORD=scholarflow
POSTGRES_DB=scholarflow
